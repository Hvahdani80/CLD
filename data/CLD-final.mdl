Average LOS  = A FUNCTION OF( Discharge Planning Quality,"Funding for Community Care/Services"\
		,Hospital Efficiency Mandates,Pressure for Cost Containment)
	~	
	~		|

Discharge Planning Quality  = A FUNCTION OF( Average LOS,Funding for Quality Improvement\
		,"Medical Error Rate (Care Quality)",Pressure for Cost Containment)
	~	
	~		|

Unmet ADL needs  = A FUNCTION OF( "Funding for Community Care/Services")
	~	
	~		|

Premature Discharge Risk  = A FUNCTION OF( Discharge Planning Quality,Clinical Stability\
		,Unmet ADL needs)
	~	
	~		|

Hospital Admissions  = A FUNCTION OF( "30-Day Readmission Rate",Hospital Capacity strain\
		,Population Growth Rate,"Proportion of High-Risk Elderly Patients (Aging population)"\
		)
	~	
	~		|

Patients Satisfaction  = A FUNCTION OF( "30-Day Readmission Rate",Discharge Planning Quality\
		,Hospital Admissions)
	~	
	~		|

Early Detection Rate  = A FUNCTION OF( "Post-Discharge Follow-up Quality")
	~	
	~		|

Staffing Levels  = A FUNCTION OF( Pressure for Cost Containment,Workload)
	~	
	~		|

Hospital Operating Costs  = A FUNCTION OF( "30-Day Readmission Rate",Average LOS,Hospital Admissions\
		)
	~	
	~		|

Pressure for Cost Containment  = A FUNCTION OF( Hospital Budget Pressure,Hospital Operating Costs\
		)
	~	
	~		|

